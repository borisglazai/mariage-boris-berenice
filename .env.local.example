# Copie ce fichier en .env.local si tu veux tester en local.
# En production sur Vercel, ces variables sont déjà configurées :
# - POSTGRES_URL / DATABASE_URL : ajoutées automatiquement quand tu connectes
#   une base Postgres dans l'onglet "Storage" du projet Vercel.
# - ADMIN_PASSWORD : à ajouter toi-même dans Settings -> Environment Variables,
#   c'est le mot de passe pour accéder à /admin.
ADMIN_PASSWORD=change-moi
